; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sarah Maria — Mermaid Adventure (Godot v0.5.1 — Princess Polish Sarah)"
; Keep the application identity stable so existing user:// saves remain reachable.
config/version="0.7.0"
config/description="Sarah Maria Mermaid Adventure — eight connected chapters, family tutorial, graceful articulated swimming, torpedo boosts and layered water wakes."
run/main_scene="res://godot/title_screen.tscn"
config/features=PackedStringArray("4.4")

[audio]

buses/default_bus_layout="res://godot/default_bus_layout.tres"

[autoload]

AppPreferences="*res://godot/app_preferences.gd"
AdventureRun="*res://godot/adventure_run.gd"
OceanAudio="*res://godot/ocean_audio.gd"
SceneFlow="*res://godot/scene_flow.gd"

[display]

window/size/viewport_width=1400
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

; Serialize offline imports to avoid intermittent native font-import crashes in 4.4.1.
; This does not change runtime threaded loading or rendering quality.
import/use_multiple_threads=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

gameplay_time={
"type": "float",
"value": 0.0
}
